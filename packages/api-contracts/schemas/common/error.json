{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campuslife.invalid/contracts/schemas/common/error.json",
  "title": "Error",
  "description": "Body of every Hub error response. Clients ignore members they do not know.",
  "type": "object",
  "required": ["code", "message"],
  "properties": {
    "code": {
      "description": "Error code. Open (x-open): the Hub may add codes, and a client treats a code it does not know as a plain failure (E21). The known codes are the examples. Mutation outcomes such as id_reuse or not_canonical also appear as a rejected result's reason (E12).",
      "type": "string",
      "pattern": "^[a-z][a-z_]*$",
      "x-open": true,
      "examples": [
        "invalid_request",
        "not_canonical",
        "id_reuse",
        "hash_mismatch",
        "chunk_mismatch",
        "incomplete",
        "unauthorized",
        "device_revoked",
        "device_dormant",
        "not_found",
        "contract_too_old",
        "hub_storage_full",
        "internal_error"
      ]
    },
    "message": {
      "description": "Human-readable explanation; never parsed.",
      "type": "string"
    },
    "details": {
      "description": "Code-specific data, such as missing_chunks for incomplete.",
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "code": { "const": "incomplete" } }, "required": ["code"] },
      "then": { "required": ["details"], "properties": { "details": { "$ref": "#/$defs/incomplete_details" } } }
    }
  ],
  "$defs": {
    "incomplete_details": {
      "description": "409 incomplete from finalize (E19): the chunk indexes still missing.",
      "type": "object",
      "required": ["missing_chunks"],
      "properties": {
        "missing_chunks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "int64.json#/$defs/non_negative" } }
      }
    }
  }
}
