{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campuslife.invalid/contracts/schemas/common/local_time_rule.json",
  "title": "Local time rule",
  "description": "A weekly timetable slot in local wall-clock time, expanded for display (D11, E13). end is after start (rule range_order) and until_date is not before from_date.",
  "type": "object",
  "required": ["weekdays", "start", "end", "tz", "from_date", "until_date"],
  "properties": {
    "weekdays": {
      "description": "ISO weekdays, Monday = 1 ... Sunday = 7.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "int64.json", "minimum": 1, "maximum": 7 }
    },
    "start": { "$ref": "#/$defs/wall_time" },
    "end": { "$ref": "#/$defs/wall_time" },
    "tz": { "$ref": "tz.json" },
    "from_date": { "$ref": "local_date.json#/$defs/calendar_date" },
    "until_date": { "$ref": "local_date.json#/$defs/calendar_date" }
  },
  "additionalProperties": false,
  "x-range-order": [
    { "start": "start", "end": "end", "strict": true },
    { "start": "from_date", "end": "until_date" }
  ],
  "$defs": {
    "wall_time": {
      "description": "Wall-clock time HH:MM, 24-hour.",
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    }
  }
}
