{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campuslife.invalid/contracts/schemas/item/item.json",
  "title": "Item",
  "description": "A user-confirmed thing (D10) as the Hub sends it in the changes feed. There is no status column (U4); a task's state is fields.progress. Open: clients ignore members they do not know and render an unknown kind from title, dates and body only.",
  "type": "object",
  "required": ["id", "kind", "schema_version", "title", "fields", "rev"],
  "properties": {
    "id": { "$ref": "../common/uuid.json", "x-owner": "client" },
    "kind": {
      "description": "MVP kinds are term, course, lecture_session, note, task, assignment and exam; later kinds arrive additively.",
      "type": "string",
      "pattern": "^[a-z][a-z_]*$",
      "x-owner": "client"
    },
    "schema_version": { "description": "Version of this kind's fields schema the row was written with.", "$ref": "../common/int64.json#/$defs/non_negative", "minimum": 1, "x-owner": "hub" },
    "title": { "type": "string", "minLength": 1, "x-owner": "user" },
    "body": { "type": "string", "x-owner": "user", "x-text": true },
    "starts_at": { "description": "local_date when all_day is true, otherwise instant (E13).", "$ref": "#/$defs/date_value", "x-owner": "user" },
    "due_at": { "description": "local_date when all_day is true, otherwise instant (E13).", "$ref": "#/$defs/date_value", "x-owner": "user" },
    "all_day": { "type": "boolean", "x-owner": "user" },
    "fields": { "description": "Kind-specific members, checked against item/fields/<kind> for the MVP kinds.", "type": "object", "x-owner": "user" },
    "rev": { "description": "change_seq of the row's last write (D3).", "$ref": "../common/int64.json#/$defs/non_negative", "x-owner": "hub" },
    "deleted_at": { "$ref": "../common/instant.json", "x-owner": "hub" },
    "status": { "description": "Removed from the common columns (U4); refused even in this open shape so it does not come back by accident.", "not": {} }
  },
  "allOf": [{ "$ref": "#/$defs/dates_follow_all_day" }, { "$ref": "#/$defs/fields_of_kind" }],
  "$defs": {
    "date_value": {
      "description": "An instant (a string) or a local_date (an object).",
      "if": { "type": "string" },
      "then": { "$ref": "../common/instant.json" },
      "else": { "$ref": "../common/local_date.json" }
    },
    "dates_follow_all_day": {
      "description": "Which of the two date shapes all_day selects; date_value has already checked the shape itself.",
      "if": { "properties": { "all_day": { "const": true } }, "required": ["all_day"] },
      "then": { "properties": { "starts_at": { "type": "object" }, "due_at": { "type": "object" } } },
      "else": { "properties": { "starts_at": { "type": "string" }, "due_at": { "type": "string" } } }
    },
    "fields_of_kind": {
      "description": "Dispatches fields to the schema of a known kind; an unknown kind keeps fields as any object (E21 forward rule).",
      "allOf": [
        { "if": { "$ref": "#/$defs/kind_is/term" }, "then": { "properties": { "fields": { "$ref": "fields/term.json" } } } },
        { "if": { "$ref": "#/$defs/kind_is/course" }, "then": { "properties": { "fields": { "$ref": "fields/course.json" } } } },
        { "if": { "$ref": "#/$defs/kind_is/lecture_session" }, "then": { "properties": { "fields": { "$ref": "fields/lecture_session.json" } } } },
        { "if": { "$ref": "#/$defs/kind_is/note" }, "then": { "properties": { "fields": { "$ref": "fields/note.json" } } } },
        { "if": { "$ref": "#/$defs/kind_is/task" }, "then": { "properties": { "fields": { "$ref": "fields/task.json" } } } },
        { "if": { "$ref": "#/$defs/kind_is/assignment" }, "then": { "properties": { "fields": { "$ref": "fields/assignment.json" } } } },
        { "if": { "$ref": "#/$defs/kind_is/exam" }, "then": { "properties": { "fields": { "$ref": "fields/exam.json" } } } }
      ]
    },
    "kind_is": {
      "term": { "properties": { "kind": { "const": "term" } }, "required": ["kind"] },
      "course": { "properties": { "kind": { "const": "course" } }, "required": ["kind"] },
      "lecture_session": { "properties": { "kind": { "const": "lecture_session" } }, "required": ["kind"] },
      "note": { "properties": { "kind": { "const": "note" } }, "required": ["kind"] },
      "task": { "properties": { "kind": { "const": "task" } }, "required": ["kind"] },
      "assignment": { "properties": { "kind": { "const": "assignment" } }, "required": ["kind"] },
      "exam": { "properties": { "kind": { "const": "exam" } }, "required": ["kind"] }
    }
  }
}
